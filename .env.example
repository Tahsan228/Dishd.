# Copy to .env.local and fill in. HOST ONLY — the Live Share guest never needs this.
# .env.local is gitignored and is not shared to the guest by Live Share.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Never import this into a client component.
SUPABASE_SERVICE_ROLE_KEY=

# Receipt extraction (Chain of Trust)
ANTHROPIC_API_KEY=

# Stripe Connect — use test mode keys for the hackathon
STRIPE_SECRET_KEY=

NEXT_PUBLIC_APP_URL=http://localhost:3000
